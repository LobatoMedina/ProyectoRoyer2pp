# ---------------------------------------------------------------
# Bolsa de Trabajo Universitaria - variables de entorno
# Este archivo lo consume docker-compose.yml en la raiz.
# Las claves fueron generadas de forma aleatoria; cambialas antes
# de desplegar en Dokploy o en cualquier entorno publico.
# ---------------------------------------------------------------

# Base de datos MariaDB
MARIADB_DATABASE=bolsa_trabajo
MARIADB_USER=bolsa_user
MARIADB_PASSWORD=CAMBIA_ESTA_PASSWORD
MARIADB_ROOT_PASSWORD=CAMBIA_ESTA_PASSWORD
MARIADB_PORT=3307

# API (Express + Prisma)
API_PORT=3010
JWT_SECRET=GENERA_UNO_CON_openssl_rand_hex_32
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:3011

# Usuario administrador y datos iniciales cargados por el seed
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=Tijuana123?
SEED_DEMO_PASSWORD=CAMBIA_ESTA_PASSWORD
SEED_DEMO_DATA=true

# Front-end (Next.js)
WEB_PORT=3011
NEXT_PUBLIC_API_URL=http://localhost:3010/api
